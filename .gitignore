# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js
/.next/
/out/

# Production build
/build
/dist

# ---------------------------------------------------------------------------
# Environment variables（秘密情報 — コミット禁止）
# .env.example はテンプレートなのでコミット OK
# ---------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
/coverage

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# ---------------------------------------------------------------------------
# Database / SQL
#
# ✅ コミットしてよいもの:
#   - prisma/schema.prisma
#   - prisma/migrations/**/migration.sql  （Prisma マイグレーション）
#   - prisma/migrations/migration_lock.toml
#   - prisma/seed.js                      （シードスクリプト・秘密情報を入れないこと）
#   - .env.example                        （接続文字列の例のみ）
#
# ❌ コミットしないもの:
#   - .env（本番/開発の DATABASE_URL 等）
#   - ローカル DB ファイル
#   - 手動ダンプ・バックアップ SQL
# ---------------------------------------------------------------------------
prisma/dev.db
*.db
*.sqlite
*.sqlite3

# 手動エクスポート・バックアップ（prisma/migrations は対象外）
/dumps/
*.dump.sql
*.sql.gz
*_backup.sql
*.sql.backup

# Prisma の generate 出力は node_modules 配下（/node_modules で除外済み）

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor（個人設定。共有したいものだけ例外）
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Misc
*.pem
.turbo
